# Copie para .env (que NÃO vai para o Git) e preencha.

# Chave exigida no cabeçalho X-API-Key por todas as rotas, exceto /health.
# Gere uma com:  python -c "import secrets; print(secrets.token_urlsafe(32))"
AI_SERVICE_API_KEY=

# Usado pelo servidor MCP (mcp_server/) para falar com este serviço.
VETFLOW_AI_URL=http://localhost:8000
